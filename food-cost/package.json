{
  "name": "food-cost",
  "version": "1.0.0",
  "private": true,
  "description": "Controllo del food cost per trattoria",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma migrate deploy && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "utente": "tsx scripts/utente.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "next": "^16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}

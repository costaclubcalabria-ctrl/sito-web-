# =============================================================================
# STRATO — variabili d'ambiente
#
# Copia questo file in `.env.local` e riempilo. `.env.local` è in .gitignore e
# NON va mai committato. Su Vercel questi valori si inseriscono in
# Settings → Environment Variables.
#
# Nessuna di queste variabili è necessaria per la Fase 1: il sito gira senza.
# Servono a partire dalla Fase 3 (pagamenti) e dalla Fase 4 (preventivi).
# =============================================================================

# --- Sito --------------------------------------------------------------------
# Origine pubblica, senza barra finale. Usata per canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (Fase 3) ---------------------------------------------------------
# Chiave segreta. In sviluppo usa la modalità test (sk_test_...).
STRIPE_SECRET_KEY=

# Segreto del webhook, da `stripe listen` in locale o dal cruscotto in produzione.
# Serve a verificare la firma: senza, chiunque può fingere un pagamento andato
# a buon fine.
STRIPE_WEBHOOK_SECRET=

# NOTA: non serve alcuna chiave pubblicabile. Il redirect al Checkout avviene
# dal server usando `session.url`, quindi l'SDK Stripe non entra nel bundle
# del client. Vedi PLAN.md §2.3.

# --- Resend (Fase 4) ---------------------------------------------------------
RESEND_API_KEY=

# Mittente delle email transazionali. Il dominio deve essere verificato su
# Resend, altrimenti le email finiscono in spam o vengono rifiutate.
EMAIL_FROM="STRATO <ordini@esempio.it>"

# Dove arrivano le richieste di preventivo.
EMAIL_TO=

# --- Storage dei file caricati (Fase 4) --------------------------------------
# Vercel Blob. Il browser carica direttamente qui: un STL non passa mai dalla
# serverless function, che ha un limite di 4,5 MB sul body. Vedi PLAN.md §2.2.
BLOB_READ_WRITE_TOKEN=
